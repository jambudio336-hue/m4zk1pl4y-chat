# M4ZKIPLAY Edge Function server-only secrets.
# Generate a random value of at least 32 characters and set it in:
# Supabase Dashboard > Edge Functions > Secrets
# Name: M4ZK_SESSION_SECRET
# Never commit the real value or expose it through EXPO_PUBLIC_*.
M4ZK_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
